generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  email              String   @unique
  password           String
  role               String   @default("attendant") // admin, supervisor, attendant
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  showInSendAs       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignments ConversationAssignment[]
  whatsappAssignments WhatsAppAssignment[]
  pushSubscriptions PushSubscription[]
  quickMessages QuickMessage[]

  @@index([username])
  @@index([role])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model WhatsAppAccount {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  status         String   @default("DISCONNECTED")
  lastConnection DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversations Conversation[]
  contacts      Contact[]
  messages      Message[]
  logs          SystemLog[]
  chatbots      Chatbot[]
  assignments   WhatsAppAssignment[]
  baileysAuth   BaileysAuthState[]
  scheduledMessages ScheduledMessage[]
  automations   Automation[]

  @@index([status])
}

model WhatsAppAssignment {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappId  String
  whatsapp    WhatsAppAccount @relation(fields: [whatsappId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, whatsappId])
  @@index([userId])
  @@index([whatsappId])
}

model Contact {
  id           String   @id @default(cuid())
  phone        String
  name         String?
  avatarUrl    String?
  lastMessage  String?
  lastContact  DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  whatsappId   String
  whatsapp     WhatsAppAccount @relation(fields: [whatsappId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([phone, whatsappId])
  @@index([whatsappId])
  @@index([phone])
}

model Conversation {
  id             String   @id @default(cuid())
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappId     String
  whatsapp       WhatsAppAccount @relation(fields: [whatsappId], references: [id], onDelete: Cascade)
  lastMessage    String?
  lastMessageAt  DateTime?
  unreadCount    Int      @default(0)
  isOpen         Boolean  @default(true)
  aiEnabled      Boolean  @default(true)
  isMuted        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages      Message[]
  tags          ConversationTag[]
  assignments   ConversationAssignment[]
  archives      MessageArchive[]

  @@unique([contactId, whatsappId])
  @@index([whatsappId])
  @@index([lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  whatsappId     String
  whatsapp       WhatsAppAccount @relation(fields: [whatsappId], references: [id], onDelete: Cascade)
  type           String   @default("text")
  content        String?
  mediaUrl       String?
  mediaType      String?
  /// Metadados de mídia (mediaKey, directPath, etc.) para recuperação automática após reinício de container
  mediaData      String?
  caption        String?
  isFromMe       Boolean  @default(false)
  isRead         Boolean  @default(false)
  quotedMessageId String?
  quotedContent   String?
  senderName      String?
  senderJid       String?
  /// ID original da mensagem no WhatsApp (ex: key.id do Baileys).
  /// Usado como chave de deduplicação garantida pelo banco.
  waMsgId        String?
  /// Timestamp REAL da mensagem conforme o WhatsApp (messageTimestamp).
  /// Usado para ordenação cronológica correta. Nunca use createdAt para isso.
  timestamp      DateTime?
  /// Legado — mantido para compatibilidade com dados existentes.
  messageId      String?
  fromPhone      String?
  toPhone        String?
  createdAt      DateTime @default(now())

  @@unique([conversationId, waMsgId])
  @@index([conversationId])
  @@index([conversationId, timestamp])
  @@index([whatsappId])
  @@index([timestamp])
  @@index([createdAt])
  @@index([isRead])
  @@index([waMsgId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now())

  conversations ConversationTag[]

  @@index([name])
}

model ConversationTag {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contactId      String
  tagId          String
  tag            Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())

  @@unique([conversationId, tagId])
  @@index([tagId])
  @@index([conversationId])
}

model ConversationAssignment {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  assignedAt     DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   @default("info")
  message   String
  source    String?
  whatsappId String?
  whatsapp   WhatsAppAccount? @relation(fields: [whatsappId], references: [id], onDelete: Cascade)
  metadata  String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([whatsappId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  title     String
  body      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model Chatbot {
  id               String   @id @default(cuid())
  name             String
  whatsappAccountId String
  whatsappAccount  WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  isActive         Boolean  @default(true)
  useAi            Boolean  @default(false)
  greetingMessage  String?
  fallbackMessage  String?
  triggerMode      String   @default("any") // any, first_message, keyword_only
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  autoReplies      AutoReply[]

  @@index([whatsappAccountId])
  @@index([isActive])
}

model AutoReply {
  id           String   @id @default(cuid())
  chatbotId    String
  chatbot      Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  triggerType  String   @default("contains") // exact, contains, starts_with, regex, always
  trigger      String
  reply        String
  mediaType    String   @default("text") // text, image
  mediaUrl     String?
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([chatbotId])
  @@index([isActive])
}

model BaileysAuthState {
  id             String   @id @default(cuid())
  whatsappId     String
  whatsapp       WhatsAppAccount @relation(fields: [whatsappId], references: [id], onDelete: Cascade)
  dataId         String   // ex: 'creds', 'app-state-sync-key-xxx'
  data           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([whatsappId, dataId])
  @@index([whatsappId])
}

model QuickMessage {
  id        String   @id @default(cuid())
  title     String
  shortcut  String
  content   String   @db.Text
  category  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shortcut])
  @@index([title])
  @@index([userId])
}

model MessageArchive {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  whatsappId     String
  driveFileId    String?
  fileName       String
  messageCount   Int          @default(0)
  firstTimestamp DateTime?
  lastTimestamp  DateTime?
  fileSize       Int          @default(0)
  syncedToDrive  Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([whatsappId])
  @@index([syncedToDrive])
}

/// Mensagem agendada para envio futuro a um contato (ver scheduledMessageService).
model ScheduledMessage {
  id            String   @id @default(cuid())
  whatsappId    String
  whatsapp      WhatsAppAccount @relation(fields: [whatsappId], references: [id], onDelete: Cascade)
  /// Telefone (apenas dígitos) ou JID completo (@g.us / @lid) do destinatário.
  toPhone       String
  contactName   String?
  content       String   @db.Text
  /// Atendente identificado na mensagem (mesmo comportamento do "Enviar como" das conversas).
  senderName    String?
  scheduledAt   DateTime
  /// PENDING | SENDING | SENT | FAILED | CANCELED
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  lastError     String?
  sentAt        DateTime?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([whatsappId])
}

/// Automação de agendamento: envia aos clientes os horários livres (lidos das agendas Google)
/// e um link onde o cliente escolhe e confirma a reunião. Ver automationService.
model Automation {
  id                   String   @id @default(cuid())
  name                 String
  type                 String   @default("BOOKING")
  whatsappId           String
  whatsapp             WhatsAppAccount @relation(fields: [whatsappId], references: [id], onDelete: Cascade)
  /// DRAFT | ACTIVE (enviando) | PAUSED
  status               String   @default("DRAFT")
  bookingOpen          Boolean  @default(true)
  /// [{ id, name }] — agendas cujos compromissos bloqueiam horários
  calendars            Json
  targetCalendarId     String?
  meetingTitle         String   @default("Revisão de apólice")
  durationMinutes      Int      @default(30)
  bufferMinutes        Int      @default(15)
  daysAhead            Int      @default(14)
  minNoticeHours       Int      @default(24)
  slotsInMessage       Int      @default(6)
  /// { "1": [["09:00","12:00"],["13:30","18:00"]], ... } — 0 = domingo
  workingHours         Json
  skipHolidays         Boolean  @default(true)
  messageTemplate      String   @db.Text
  confirmationTemplate String   @db.Text
  senderName           String?
  publicBaseUrl        String?
  sendWindowStart      String   @default("09:00")
  sendWindowEnd        String   @default("19:00")
  lastError            String?
  createdById          String?
  createdByName        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  recipients           AutomationRecipient[]
  bookings             AutomationBooking[]

  @@index([status])
}

model AutomationRecipient {
  id           String   @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  phone        String
  name         String?
  source       String?
  token        String   @unique
  /// PENDING | SENT | FAILED | SKIPPED
  status       String   @default("PENDING")
  attempts     Int      @default(0)
  lastError    String?
  sentAt       DateTime?
  openedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([automationId, phone])
  @@index([automationId, status])
}

model AutomationBooking {
  id              String   @id @default(cuid())
  automationId    String
  automation      Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  recipientId     String?
  phone           String
  name            String?
  startAt         DateTime
  endAt           DateTime
  /// CONFIRMED | CANCELED
  status          String   @default("CONFIRMED")
  calendarEventId String?
  calendarError   String?
  canceledBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([automationId, startAt])
  @@index([recipientId])
}

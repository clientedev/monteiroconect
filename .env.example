# ===========================================
# Monteiro Conecta - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e ajuste os valores

# Servidor
PORT=3001
NODE_ENV=development

# Banco de Dados
# Local (docker compose): PostgreSQL exposto na porta 5432
# Railway/Produção:       postgresql://...  (fornecido automaticamente pelo plugin PostgreSQL do Railway)
DATABASE_URL=postgresql://wa_central:wa_central_pass@localhost:5432/wa_central

# JWT
JWT_SECRET=change-me-to-a-random-secret-key
JWT_EXPIRES_IN=24h

# Sessões WhatsApp
# No Railway, aponte para um Volume (ex: /data/sessions) para persistir entre deploys
SESSIONS_PATH=./sessions
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_INITIAL_DELAY=5000
RECONNECT_MAX_DELAY=60000
# Importa somente conversas recentes ao conectar uma conta pela primeira vez
HISTORY_SYNC_DAYS=30
HISTORY_MESSAGE_LIMIT=500

# Uploads
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=50MB

# Logs
LOG_LEVEL=info
LOG_PATH=./logs

# Admin inicial (criado automaticamente na primeira execução)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@monteiroconecta.local

# CORS (produção no Railway: mesma origem, pode usar *)
CORS_ORIGIN=http://localhost:5173

# IA do chatbot (Google Gemini API / camada gratuita)
# Gere a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: só altere se usar um endpoint compatível
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Integration API CRM Monteiro Seguros
CRM_BASE_URL=https://seu-dominio.com
CRM_API_KEY=ms_live_8a7c289eda9bd623177b50c7e489df3b

# ===========================================
# Backup Google Drive & Alívio PostgreSQL (Railway)
# ===========================================
# ID da pasta do Google Drive (da URL compartilhada)
GOOGLE_DRIVE_FOLDER_ID=1kTk-ANgqNWa9ff25l4_FK-7LrjnKpJb_

# Credenciais da Conta de Serviço do Google (Service Account JSON colado diretamente ou em base64)
# Compartilhe a pasta do Drive com o email da conta de serviço como "Editor"
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternativamente, caminho para arquivo JSON de credenciais se montado via volume:
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# Quantidade máxima de mensagens recentes mantidas no Postgres por conversa (o restante vai pro backup)
ARCHIVE_KEEP_MESSAGES_PER_CONV=100

# Dias de retenção dos logs do sistema (logs mais velhos são purgados para aliviar o banco)
ARCHIVE_LOG_RETENTION_DAYS=7

# Alívio automático periódico em background (true/false)
ARCHIVE_AUTO_ENABLED=true
ARCHIVE_AUTO_INTERVAL_HOURS=6

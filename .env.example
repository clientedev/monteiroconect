# ===========================================
# WA Central - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e ajuste os valores

# Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Banco de Dados
# SQLite (desenvolvimento)
DATABASE_URL=file:./dev.db

# PostgreSQL (produção - descomente e comente o SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/wa_central

# JWT
JWT_SECRET=change-me-to-a-random-secret-key
JWT_EXPIRES_IN=24h

# Sessões WhatsApp
SESSIONS_PATH=./sessions
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_INITIAL_DELAY=5000
RECONNECT_MAX_DELAY=60000

# Uploads
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=50MB

# Logs
LOG_LEVEL=info
LOG_PATH=./logs

# Admin inicial (criado automaticamente na primeira execução)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@wa-central.local

# Redis (opcional - para rate limiting avançado)
# REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:5173
